<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="TSListCreator.Views.ModeChoiceView">
    <StackPanel Orientation="Vertical" Background="WhiteSmoke">
        <ToggleButton x:Name="MoveButton"
                      Height="40"
                      Width="40"
                      Padding="2"
                      BorderBrush="Black"
                      BorderThickness="1">
            <PathIcon Foreground="Black"
                      Padding="2"
                      Data="{DynamicResource Move}"/>
        </ToggleButton>
        <ToggleButton x:Name="StretchButton"
                Height="40"
                Width="40"
                Padding="2"
                BorderBrush="Black"
                BorderThickness="1">
            <PathIcon Foreground="Black"
                      Padding="2"
                      Data="{DynamicResource Stretch}"/>
        </ToggleButton>
    </StackPanel>
</UserControl>
