<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:TsListCreator.Presentation.Converters"
             xmlns:viewModels="clr-namespace:TsListCreator.Shared.ViewModels;assembly=TsListCreator.Shared"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="viewModels:ISettingsViewModel"
             x:Class="TsListCreator.Presentation.Views.SettingsView">
    <UserControl.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <Grid ColumnDefinitions="Auto, Auto, Auto, *"
              RowDefinitions="Auto, Auto">
            <Label Grid.Column="2"
                   Grid.Row="0"
                   Content="Ширина объекта в игре"/>
            <TextBox Grid.Column="3"
                     Grid.Row="0"
                     HorizontalAlignment="Stretch"
                     Text="{Binding BoundWidth, Converter={StaticResource StringToDoubleConverter}}" />
            <Label Grid.Column="2"
                   Grid.Row="1"
                   Content="Длина объекта в игре"/>
            <TextBox Grid.Column="3"
                     Grid.Row="1"
                     HorizontalAlignment="Stretch"
                     Text="{Binding BoundHeight, Converter={StaticResource StringToDoubleConverter}}"/>

            <Label Grid.Column="0"
                   Grid.Row="0"
                   Content="Цвет контролов"/>
            <ColorPicker Grid.Column="1"
                         Grid.Row="0"
                         ColorModel="Rgba"
                         HorizontalAlignment="Stretch"
                         Color="{Binding Background, Mode=TwoWay}" />

            <Label Grid.Column="0"
                   Grid.Row="1"
                   Content="Цвет шрифта"/>
            <ColorPicker Grid.Column="1"
                         Grid.Row="1"
                         ColorModel="Rgba"
                         HorizontalAlignment="Stretch"
                         Color="{Binding FontColor, Mode=TwoWay}" />
        </Grid>
    </StackPanel>
</UserControl>
